# GAN Face Generator Environment Configuration

# Path to trained PyTorch Generator model state dict file
MODEL_PATH=generator.pth

# Host interface binding (0.0.0.0 for production containers, 127.0.0.1 for local dev)
HOST=0.0.0.0

# HTTP port server listens on
PORT=8000

# Allowed CORS origins (comma-separated list, or * for open public access)
CORS_ORIGINS=*
