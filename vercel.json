{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix generative-ai-lab/frontend install && npm --prefix generative-ai-lab/frontend run build",
  "outputDirectory": "generative-ai-lab/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://genai-lab-backend.onrender.com/api/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "https://genai-lab-backend.onrender.com/outputs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
